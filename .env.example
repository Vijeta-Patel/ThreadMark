# Copy this file to web/.env.local and fill in the values. Never commit real values.

# Supabase (browser and server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase (SERVER ONLY, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Blockchain (same names as blockchain/hardhat.config.ts)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
CONTRACT_ADDRESS=
# mock = in-memory chain for local development only (never on Vercel); real = ethers + the contract
CHAIN_MODE=mock

# Used in the QR code URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Prefix for transaction links, e.g. https://sepolia.etherscan.io/tx/ (leave empty locally)
NEXT_PUBLIC_EXPLORER_TX_URL=
